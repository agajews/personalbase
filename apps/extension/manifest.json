{
  "manifest_version": 3,
  "name": "personalbase capture",
  "version": "0.1.0",
  "description": "Save the current page into personalbase with one click.",
  "action": {
    "default_title": "Save to personalbase"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.sprites.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
